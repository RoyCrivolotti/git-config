[user]
    email = roycrivolotti@gmail.com
    name = Roy Crivolotti

[alias]
    co = checkout
    cob = checkout -b
    c = commit
    ce = ! git commit -m \"Empty commit\" --allow-empty
    a = add
    s = status -sb
    d = diff
    amend = commit --amend --no-edit
    pushr = !git push --set-upstream origin $(git branch --show-current)
    getremote = remote get-url origin
    alias = ! git config --get-regexp ^alias\\. | sed -e s/^alias\\.// -e s/\\ /\\ =\\ /

    # List files changed by latest commit
    lastfiles = diff-tree --no-commit-id --name-status -r HEAD

    # Same as above, but with commit message
    lastfilesm = show --name-status --oneline HEAD

    # Show changed files
    lsdiff = diff --name-status

    # Show changed files compared to a branch passed as arg
    lsdiffbranch = "!f() { [ -n \"$1\" ] || { echo 'Usage: git lsdiffbranch <branch>'; return 1; }; git diff --name-status \"$1\"; }; f"

    # Diff local branch against its upstream remote branch
    diffr = "!git diff @{upstream}"

    # Same as diffr, but only for one file
    diffrf = "!f() { [ -n \"$1\" ] || { echo 'Usage: git diffrf <file>'; return 1; }; git rev-parse --abbrev-ref @{upstream} >/dev/null 2>&1 || { echo 'No upstream set for current branch'; return 1; }; git diff @{upstream} -- \"$1\"; }; f"

    # Diff current branch against another branch, or main if none is passed
    diffb = "!f() { base=${1:-main}; git diff \"$base\"...HEAD; }; f"

    # Same as diffb, but only for one file
    diffbf = "!f() { if [ $# -eq 1 ]; then base=main; file=$1; elif [ $# -eq 2 ]; then base=$1; file=$2; else echo 'Usage: git diffbf [branch] <file>'; return 1; fi; git diff \"$base\"...HEAD -- \"$file\"; }; f"

    lg = log --oneline --graph --decorate --all

    branch-info = "!f() { \
        green=$(tput setaf 2); \
        cyan=$(tput setaf 6); \
        reset=$(tput sgr0); \
        printf \"%b%-20s %-16s %-1s%b\\n\" \"$green\" \"Commit Date\" \"Relative Time\" \"Branch\" \"$reset\"; \
        for k in $(git branch | perl -pe 's/^..//'); do \
            commit_info=$(git show --pretty=format:\"%cd %cr\" --date=format:'%Y-%m-%d %H:%M:%S' $k -- | head -n 1); \
            commit_date=$(echo $commit_info | awk '{print $1, $2}'); \
            commit_time=$(echo $commit_info | awk '{print $3}'); \
            commit_relative=$(echo $commit_info | awk '{print $4, $5, $6}'); \
            printf \"%b%-19s  %b%-15s%b  %s%b\\n\" \"$green\" \"$commit_date\" \"$cyan\" \"$commit_time $commit_relative\" \"$reset\" \"$k\" \"$reset\"; \
        done | sort -r; \
    }; f" ## Display branch information with commit date and relative time

